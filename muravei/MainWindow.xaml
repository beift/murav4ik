<Window x:Class="muravei.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:muravei"
        mc:Ignorable="d"
        Title="Муравчик" Height="696" Width="900">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Игровое поле -->

        <!-- Игровое поле -->
        <Border Grid.Column="0"
        Background="White"
        BorderBrush="Gray"
        BorderThickness="1"
        Margin="0,0,10,0"
        Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Игровое поле"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="3,3,3,10"/>

                <Border Grid.Row="1"
                Background="#EEEEEE"
                Padding="10"
                ClipToBounds="True">

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                        <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                            <!-- Сетка клеток -->
                            <ItemsControl x:Name="Board"
                                  IsHitTestVisible="False"
                                  ItemsSource="{Binding Cells}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="{Binding BoardRows}"
                                             Columns="{Binding BoardColumns}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="48"
                                        Height="48"
                                        BorderBrush="#AAAAAA"
                                        BorderThickness="0.5"
                                        Background="{Binding Brush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- Стрелка муравья -->
                            <Canvas x:Name="AntCanvas"
                            IsHitTestVisible="False"
                            ClipToBounds="True">

                                <Polygon x:Name="AntArrow"
                                 Points="0,30 15,0 30,30 15,23"
                                 Fill="Black"
                                 Stroke="White"
                                 StrokeThickness="1.5"
                                 RenderTransformOrigin="0.5,0.5">

                                    <Polygon.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Polygon.RenderTransform>

                                </Polygon>

                            </Canvas>

                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>


        <!-- Панель управления -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Размер поля -->
            <GroupBox Grid.Row="0"
                      Header="Размер поля"
                      Padding="8"
                      Margin="0,0,0,10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Строки"/>
                        <TextBox x:Name="RowsTextBox"
                                 Text="10"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="×"
                               FontSize="20"
                               VerticalAlignment="Center"
                               Margin="5,10"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Столбцы"/>
                        <TextBox x:Name="ColumnsTextBox"
                                 Text="10"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="Создать"
                            VerticalAlignment="Bottom"
                            Click="CreateBoard_Click"/>
                </Grid>
            </GroupBox>

            <!-- Команды -->
            <GroupBox Grid.Row="1"
                      Header="Команды"
                      Padding="8"
                      Margin="0,0,0,10">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="На белой клетке"
                                   FontWeight="Bold"
                                   Margin="3,5"/>

                        <ListBox x:Name="WhiteCommandsList"
                                 ItemsSource="{Binding WhiteCommands}"
                                 Height="90"/>

                        <Grid Margin="0,3,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="WhiteCommandComboBox"
                                      Grid.Column="0"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="Повернуть направо"/>
                                <ComboBoxItem Content="Повернуть налево"/>
                                <ComboBoxItem Content="Идти вперёд"/>
                                <ComboBoxItem Content="Красить"/>

                            </ComboBox>

                            <Button Grid.Column="1"
                                    Content="+"
                                    Width="38"
                                    Click="AddWhiteCommand_Click"/>

                            <Button Grid.Column="2"
                                    Content="-"
                                    Width="38"
                                    Click="RemoveWhiteCommand_Click"/>
                        </Grid>

                        <TextBlock Text="На чёрной клетке"
                                   FontWeight="Bold"
                                   Margin="3,5"/>

                        <ListBox x:Name="BlackCommandsList"
                                 ItemsSource="{Binding BlackCommands}"
                                 Height="90"/>

                        <Grid Margin="0,3,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="BlackCommandComboBox"
                                      Grid.Column="0"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="Повернуть направо"/>
                                <ComboBoxItem Content="Повернуть налево"/>
                                <ComboBoxItem Content="Идти вперёд"/>
                                <ComboBoxItem Content="Красить"/>

                            </ComboBox>

                            <Button Grid.Column="1"
                                    Content="+"
                                    Width="38"
                                    Click="AddBlackCommand_Click"/>

                            <Button Grid.Column="2"
                                    Content="-"
                                    Width="38"
                                    Click="RemoveBlackCommand_Click"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- Управление игрой -->
            <GroupBox Grid.Row="2"
                      Header="Управление"
                      Padding="8">

                <StackPanel>

                    <Button x:Name="StartButton"
                            Content="Старт"
                            Height="40"
                            Click="Start_Click"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PauseButton"
                                Grid.Column="0"
                                Content="Пауза"
                                Height="35"
                                Click="Pause_Click"/>

                        <Button x:Name="ResetButton"
                                Grid.Column="1"
                                Content="Сброс"
                                Height="35"
                                Click="Reset_Click"/>

                    </Grid>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
